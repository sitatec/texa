{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (dev debug)",
      "cwd": "app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "dev",
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp",
        // Local speech-model server (run app/startserver.sh first).
        // Without these defines the app defaults to the production URLs.
        "--dart-define=KOKORO_BASE_URL=http://localhost:8765/kokoro-multi-lang-v1_0/",
        "--dart-define=KOKORO_WEB_BASE_URL=http://localhost:8765/sitatech/Kokoro-82M-v1.0-ONNX/",
        "--dart-define=PIPER_BASE_URL=http://localhost:8765/vits-piper-en_US-amy-medium/",
        "--dart-define=SILERO_VAD_MODEL_URL=http://localhost:8765/silero_vad.onnx",
        "--dart-define=SMART_TURN_MODEL_URL=http://localhost:8765/smart-turn-v3.2-int8.onnx"
      ]
    },
    {
      "name": "App Wasm (dev release)",
      "cwd": "app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "args": [
        "--wasm",
        // Local speech-model server (run app/startserver.sh first).
        // Without these defines the app defaults to the production URLs.
        "--dart-define=KOKORO_BASE_URL=http://localhost:8765/kokoro-multi-lang-v1_0/",
        "--dart-define=KOKORO_WEB_BASE_URL=http://localhost:8765/sitatech/Kokoro-82M-v1.0-ONNX/",
        "--dart-define=PIPER_BASE_URL=http://localhost:8765/vits-piper-en_US-amy-medium/",
        "--dart-define=SILERO_VAD_MODEL_URL=http://localhost:8765/silero_vad.onnx",
        "--dart-define=SMART_TURN_MODEL_URL=http://localhost:8765/smart-turn-v3.2-int8.onnx"
      ]
    }
  ]
}